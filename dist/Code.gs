/**
 * Job alerts — single-file build of src/ (generated by tools/bundle.js; edit src/, not this file).
 * Paste into Extensions → Apps Script in your tracker spreadsheet. See README.md.
 */

// ===== Main.js =====

/**
 * Main.js — menu, triggers, settings and the daily check.
 * See README.md for setup.
 */

const SKIP_TABS = ['Settings', 'How it works', '_state', '_queue'];
const STATE_TAB = '_state';
const QUEUE_TAB = '_queue';
const MAX_HASHES = 1500;
const UA = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36';
const DAY = 24 * 3600 * 1000;

/* ---------------- Menu and triggers ---------------- */

function onOpen() {
  SpreadsheetApp.getUi().createMenu('Job alerts')
    .addItem('Install daily schedule', 'install')
    .addItem('Run checks now', 'runChecks')
    .addItem('Send a test digest now', 'sendDigestNow')
    .addItem('Remove schedule', 'uninstall')
    .addToUi();
}

function install() {
  uninstall();
  ScriptApp.newTrigger('dailyJob').timeBased().everyDays(1).atHour(8).create();
  runChecks(); // baseline
  ss_().toast('Installed. Pages are checked every morning; a digest is emailed at most every ' +
    settings_().digestDays + ' days.', 'Job alerts', 15);
}

function uninstall() {
  ScriptApp.getProjectTriggers().forEach(function (t) { ScriptApp.deleteTrigger(t); });
}

function dailyJob() {
  runChecks();
  maybeSendDigest_(false);
}

function sendDigestNow() {
  maybeSendDigest_(true);
  ss_().toast('Digest sent to ' + settings_().email, 'Job alerts', 8);
}

/* ---------------- Settings ---------------- */

function ss_() { return SpreadsheetApp.getActiveSpreadsheet(); }

function settings_() {
  const sh = ss_().getSheetByName('Settings');
  const vals = sh.getRange(1, 1, Math.max(sh.getLastRow(), 1), 2).getValues();
  const m = {};
  vals.forEach(function (r) { if (r[0]) m[String(r[0]).trim()] = r[1]; });
  const list = function (s) {
    return String(s || '').split(',').map(function (x) { return x.trim().toLowerCase(); }).filter(Boolean);
  };
  return {
    email: String(m['Send emails to'] || '').trim() || Session.getEffectiveUser().getEmail(),
    digestDays: Number(m['Email at most every (days)']) || 3,
    windowDays: Number(m['Deadline reminder window (days)']) || 10,
    include: list(m['Job keywords (any)']).map(wordRe_),
    exclude: list(m['Exclude if title contains']).map(wordRe_),
    done: list(m['Statuses to stop tracking']),
    lastSent: m['Last digest sent']
  };
}

function setSetting_(label, value) {
  const sh = ss_().getSheetByName('Settings');
  const vals = sh.getRange(1, 1, sh.getLastRow(), 1).getValues();
  for (let i = 0; i < vals.length; i++) {
    if (String(vals[i][0]).trim() === label) { sh.getRange(i + 1, 2).setValue(value); return; }
  }
}

/* ---------------- Reading the tracker ---------------- */

function collectRows_() {
  const out = [];
  ss_().getSheets().forEach(function (sh) {
    const tab = sh.getName();
    if (SKIP_TABS.indexOf(tab) >= 0) return;
    const lastRow = sh.getLastRow(), lastCol = sh.getLastColumn();
    if (lastRow < 2 || lastCol < 2) return;
    const data = sh.getRange(1, 1, lastRow, lastCol).getValues();
    const h = {};
    data[0].forEach(function (v, i) { h[String(v).trim()] = i; });
    if (h['Link'] === undefined || h['Monitor'] === undefined) return;
    const get = function (row, name) { return h[name] === undefined ? '' : row[h[name]]; };
    for (let r = 1; r < data.length; r++) {
      const row = data[r];
      const title = String(get(row, 'Role / Programme') || get(row, 'Board') || '').trim();
      if (!title) continue;
      out.push({
        tab: tab, sheet: sh, rowNum: r + 1, h: h, title: title,
        org: String(get(row, 'Organisation') || '').trim(),
        link: String(get(row, 'Link') || '').trim(),
        monitor: String(get(row, 'Monitor') || '').trim().toLowerCase(),
        feed: String(get(row, 'Feed') || '').trim(),
        status: String(get(row, 'Status') || '').trim().toLowerCase(),
        opens: toDate_(get(row, 'Opens (date)')),
        deadline: toDate_(get(row, 'Deadline (date)'))
      });
    }
  });
  return out;
}

function toDate_(v) {
  if (Object.prototype.toString.call(v) === '[object Date]' && !isNaN(v)) return v;
  if (typeof v === 'string' && v.trim()) { const d = new Date(v); if (!isNaN(d)) return d; }
  return null;
}

function keyOf_(t) { return t.tab + '|' + t.title + '|' + t.org; }

/* ---------------- Checking ---------------- */

function runChecks() {
  const cfg = settings_();
  const targets = collectRows_().filter(function (t) {
    if (cfg.done.indexOf(t.status) >= 0) return false;
    if (t.monitor === 'feed') return !!t.feed;
    return (t.monitor === 'page' || t.monitor === 'board') && /^https?:\/\//i.test(t.link);
  });
  const state = loadState_();
  const now = new Date();
  const requests = targets.map(function (t) {
    let url;
    try { url = t.monitor === 'feed' ? feedUrl_(t.feed) : t.link; } catch (e) { return null; }
    return { url: url, muteHttpExceptions: true, followRedirects: true,
             headers: { 'User-Agent': UA, 'Accept-Language': 'en-GB,en;q=0.9' } };
  });
  const responses = fetchAllSafe_(requests);
  const findings = [];
  const statusUpdates = [];

  targets.forEach(function (t, i) {
    const key = keyOf_(t);
    const prev = state[key];
    let cur;
    try { cur = analyse_(t, responses[i], cfg); } catch (e) { cur = { error: String(e.message || e).slice(0, 80) }; }

    if (cur.error) {
      const misses = ((prev && prev.misses) || 0) + 1;
      state[key] = Object.assign({}, prev || {}, { misses: misses });
      if (misses === 3) {
        findings.push(finding_('unreadable', t,
          'Could not read this for 3 checks in a row (' + cur.error + '). Check the link, or set Monitor to "Native alert" and use the site\'s own alerts.'));
      }
      statusUpdates.push([t, now, 'unreadable (' + cur.error + ')']);
      return;
    }

    const prevSet = {};
    ((prev && prev.hashes) || []).forEach(function (x) { prevSet[x] = true; });
    const isBaseline = !prev || !prev.hashes;

    if (!isBaseline) {
      if (t.monitor === 'page') {
        if (cur.state === 'open' && prev.state !== 'open' && (cur.strongOpen || prev.state === 'closed')) {
          findings.push(finding_('opened', t, cur.openLine || 'Page now reads as open.'));
        } else {
          const fresh = cur.lines.filter(function (l) { return !prevSet[h8_(l)]; }).slice(0, 3);
          if (fresh.length) findings.push(finding_('changed', t, fresh.join(' … ')));
        }
      } else {
        cur.items.filter(function (it) { return !prevSet[h8_(it.id)]; }).slice(0, 10).forEach(function (it) {
          findings.push(finding_('posting', t, it.title + (it.loc ? ' — ' + it.loc : ''), it.url || t.link));
        });
      }
    }

    // Remember everything seen, so items that briefly disappear are not re-announced.
    const merged = cur.hashes.concat(Object.keys(prevSet).filter(function (x) { return cur.hashes.indexOf(x) < 0; }));
    state[key] = { state: cur.state || '', hashes: merged.slice(0, MAX_HASHES), misses: 0 };
    statusUpdates.push([t, now, t.monitor === 'page' ? (cur.state || 'unclear') : cur.items.length + ' matching listings']);
  });

  saveState_(state);
  appendQueue_(findings);
  writeStatuses_(statusUpdates);
}

function finding_(type, t, detail, url) {
  return [new Date(), type, t.tab, t.title, t.org, url || t.link, detail];
}

function fetchAllSafe_(reqs) {
  const out = reqs.map(function () { return null; });
  const CHUNK = 15;
  for (let i = 0; i < reqs.length; i += CHUNK) {
    const idx = [], batch = [];
    for (let j = i; j < Math.min(i + CHUNK, reqs.length); j++) {
      if (reqs[j]) { idx.push(j); batch.push(reqs[j]); } else { out[j] = { error: 'bad feed name' }; }
    }
    if (!batch.length) continue;
    try {
      UrlFetchApp.fetchAll(batch).forEach(function (r, k) { out[idx[k]] = r; });
    } catch (e) {
      // One bad address can sink a whole batch; fall back to one at a time.
      idx.forEach(function (j, k) {
        try { out[j] = UrlFetchApp.fetch(batch[k].url, batch[k]); }
        catch (e2) { out[j] = { error: String(e2.message || e2).slice(0, 80) }; }
      });
    }
  }
  return out;
}

function analyse_(t, res, cfg) {
  if (!res) return { error: 'no response' };
  if (res.error) return { error: res.error };
  const code = res.getResponseCode();
  if (code >= 400) return { error: 'HTTP ' + code };
  const body = res.getContentText();

  if (t.monitor === 'feed') {
    const items = parseFeed_(t.feed, body).filter(function (j) { return titleMatches_(j.title, cfg); });
    return { items: items, hashes: items.map(function (j) { return h8_(j.id); }) };
  }

  const lines = htmlToLines_(body, t.monitor === 'board');
  const textLen = lines.join(' ').length;
  if (textLen < 300) return { error: 'page looks empty, probably built with JavaScript' };

  if (t.monitor === 'board') {
    const seen = {};
    const items = lines.filter(function (l) {
      if (l.length < 8 || l.length > 160 || seen[l]) return false;
      seen[l] = true;
      return titleMatches_(l, cfg);
    }).map(function (l) { return { id: l, title: l }; });
    return { items: items, hashes: items.map(function (x) { return h8_(x.id); }) };
  }

  const det = detectState_(lines);
  const rel = lines.filter(function (l) {
    return l.length >= 25 && l.length <= 400 && RELEVANT.test(l) && !NOISE.test(l);
  });
  return { state: det.state, strongOpen: det.strongOpen, openLine: det.line, lines: rel, hashes: rel.map(h8_) };
}


// ===== Parse.js =====

/**
 * Parse.js — pure functions with no Apps Script dependencies.
 * Covered by the tests in /test, which run in plain Node.
 */

function wordRe_(k) {
  return new RegExp('\\b' + k.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\b', 'i');
}

function titleMatches_(s, cfg) {
  if (!s) return false;
  const inc = !cfg.include.length || cfg.include.some(function (re) { return re.test(s); });
  return inc && !cfg.exclude.some(function (re) { return re.test(s); });
}

const MONTH = '(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*';
const STRONG_OPEN = [
  /applications? (?:are|is) (?:now )?open/i,
  /now (?:open for|accepting) applications/i,
  /applications? (?:for [^.]{0,80}? )?(?:are|is|have) (?:now )?(?:open|opened)\b/i,
  /applications? open(?:ed)? (?:now|today)/i,
  new RegExp('(?:apply|applications? (?:close|closes|are due|due)) (?:by|on|before) (?:\\w+day,? )?\\d{1,2}(?:st|nd|rd|th)? ' + MONTH, 'i'),
  new RegExp('(?:apply|applications? (?:close|closes|are due|due)) (?:by|on|before) ' + MONTH + ' \\d{1,2}', 'i')
];
const WEAK_OPEN = [
  /\bapply (?:now|here|online|today)\b/i, /start your application/i, /submit your application/i,
  /closing date/i, /deadline for applications/i
];
const CLOSED = [
  /applications? (?:are|is|have|has) (?:now )?closed/i, /applications? closed\b/i,
  /(?:is|are) (?:now |currently )?closed\b/i, /not currently (?:recruiting|accepting|open|hiring)/i,
  /no (?:current |open )?(?:positions|vacancies|openings|opportunities|roles)(?: available| open)?/i,
  /currently no (?:vacancies|positions|opportunities|openings|roles)/i,
  /register (?:your )?interest/i, /expression of interest/i, /will (?:re-?)?open (?:in|on)\b/i,
  /opening soon/i, /\bopens in\b/i, /check back/i, /sign up to (?:be notified|hear|our mailing)/i
];
const RELEVANT = /(appl(?:y|ication)|deadline|closing date|\bopen(?:s|ed|ing)?\b|\bclose[sd]?\b|intake|cohort|recruit|register|\b20(?:26|27|28)\b)/i;
const NOISE = /(last (?:updated|modified)|©|copyright|cookie|all rights reserved)/i;

function detectState_(lines) {
  let strong = null, weak = 0, closed = 0;
  lines.forEach(function (l) {
    if (!strong && STRONG_OPEN.some(function (re) { return re.test(l); })) strong = l;
    if (WEAK_OPEN.some(function (re) { return re.test(l); })) weak++;
    if (CLOSED.some(function (re) { return re.test(l); })) closed++;
  });
  if (strong) return { state: 'open', strongOpen: true, line: strong.slice(0, 250) };
  if (closed > weak) return { state: 'closed', strongOpen: false };
  if (weak > 0) return { state: 'open', strongOpen: false };
  return { state: 'unclear', strongOpen: false };
}

function htmlToLines_(html, splitLinks) {
  let s = String(html)
    .replace(/<!--[\s\S]*?-->/g, ' ')
    .replace(/<(script|style|noscript|svg|nav|footer|form|iframe|template|select)\b[\s\S]*?<\/\1>/gi, ' ');
  const blockEnd = splitLinks
    ? /<\/?(?:br|p|div|li|ul|ol|h[1-6]|tr|td|th|a|section|article|header|button|dt|dd|table)\b[^>]*>/gi
    : /<\/?(?:br|p|div|li|ul|ol|h[1-6]|tr|td|th|section|article|header|button|dt|dd|table)\b[^>]*>/gi;
  s = s.replace(blockEnd, '\n').replace(/<[^>]+>/g, ' ');
  s = decode_(s);
  const out = [];
  s.split('\n').forEach(function (l) {
    l = l.replace(/\s+/g, ' ').trim();
    if (l && out[out.length - 1] !== l) out.push(l);
  });
  return out;
}

function decode_(s) {
  return s
    .replace(/&#(\d+);/g, function (m, n) { return String.fromCharCode(+n); })
    .replace(/&#x([0-9a-f]+);/gi, function (m, n) { return String.fromCharCode(parseInt(n, 16)); })
    .replace(/&nbsp;/g, ' ').replace(/&quot;/g, '"').replace(/&(?:apos|rsquo|lsquo);/g, "'")
    .replace(/&(?:ldquo|rdquo);/g, '"').replace(/&(?:ndash|mdash);/g, '-')
    .replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
}

/* ---------------- Job-system feeds ---------------- */

function feedUrl_(feed) {
  const parts = feed.split(':');
  const type = parts[0].trim().toLowerCase(), id = encodeURIComponent((parts[1] || '').trim());
  if (!id) throw new Error('no id');
  if (type === 'greenhouse') return 'https://boards-api.greenhouse.io/v1/boards/' + id + '/jobs';
  if (type === 'lever') return 'https://api.lever.co/v0/postings/' + id + '?mode=json';
  if (type === 'ashby') return 'https://api.ashbyhq.com/posting-api/job-board/' + id;
  if (type === 'workable') return 'https://apply.workable.com/api/v1/widget/accounts/' + id;
  throw new Error('unknown feed type ' + type);
}

function parseFeed_(feed, body) {
  const type = feed.split(':')[0].trim().toLowerCase();
  const d = JSON.parse(body);
  if (type === 'greenhouse') return (d.jobs || []).map(function (j) {
    return { id: String(j.id), title: j.title, url: j.absolute_url, loc: j.location && j.location.name }; });
  if (type === 'lever') return (d || []).map(function (j) {
    return { id: j.id, title: j.text, url: j.hostedUrl, loc: j.categories && j.categories.location }; });
  if (type === 'ashby') return (d.jobs || []).map(function (j) {
    return { id: j.id || j.jobUrl, title: j.title, url: j.jobUrl, loc: j.location }; });
  if (type === 'workable') return (d.jobs || []).map(function (j) {
    return { id: j.shortcode || j.url, title: j.title, url: j.url || j.shortlink,
             loc: [j.city, j.country].filter(Boolean).join(', ') }; });
  return [];
}

// ===== Storage.js =====

/**
 * Storage.js — hidden _state and _queue tabs, and the short hash used to remember what has been seen.
 */

function h8_(s) {
  const norm = String(s).toLowerCase().replace(/\s+/g, ' ').trim();
  const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, norm, Utilities.Charset.UTF_8);
  return bytes.slice(0, 5).map(function (b) { return ((b + 256) % 256).toString(16).padStart(2, '0'); }).join('');
}

function hiddenSheet_(name, header) {
  let sh = ss_().getSheetByName(name);
  if (!sh) {
    sh = ss_().insertSheet(name);
    sh.getRange(1, 1, 1, header.length).setValues([header]);
    sh.hideSheet();
  }
  return sh;
}

function loadState_() {
  const sh = hiddenSheet_(STATE_TAB, ['key', 'json']);
  const st = {};
  if (sh.getLastRow() < 2) return st;
  sh.getRange(2, 1, sh.getLastRow() - 1, 2).getValues().forEach(function (r) {
    if (r[0]) { try { st[r[0]] = JSON.parse(r[1]); } catch (e) {} }
  });
  return st;
}

function saveState_(st) {
  const sh = hiddenSheet_(STATE_TAB, ['key', 'json']);
  const rows = Object.keys(st).map(function (k) { return [k, JSON.stringify(st[k])]; });
  if (sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, 2).clearContent();
  if (rows.length) sh.getRange(2, 1, rows.length, 2).setValues(rows);
}

const QUEUE_HEADER = ['found', 'type', 'tab', 'title', 'organisation', 'link', 'detail'];

function appendQueue_(findings) {
  if (!findings.length) return;
  const sh = hiddenSheet_(QUEUE_TAB, QUEUE_HEADER);
  sh.getRange(sh.getLastRow() + 1, 1, findings.length, QUEUE_HEADER.length).setValues(findings);
}

function readQueue_() {
  const sh = hiddenSheet_(QUEUE_TAB, QUEUE_HEADER);
  if (sh.getLastRow() < 2) return [];
  return sh.getRange(2, 1, sh.getLastRow() - 1, QUEUE_HEADER.length).getValues();
}

function clearQueue_() {
  const sh = hiddenSheet_(QUEUE_TAB, QUEUE_HEADER);
  if (sh.getLastRow() > 1) sh.deleteRows(2, sh.getLastRow() - 1);
}

function writeStatuses_(updates) {
  updates.forEach(function (u) {
    const t = u[0];
    if (t.h['Last checked'] !== undefined) t.sheet.getRange(t.rowNum, t.h['Last checked'] + 1).setValue(u[1]);
    if (t.h['Detected state'] !== undefined) t.sheet.getRange(t.rowNum, t.h['Detected state'] + 1).setValue(u[2]);
  });
}

// ===== Digest.js =====

/**
 * Digest.js — builds and sends the summary email.
 */

function maybeSendDigest_(force) {
  const cfg = settings_();
  const now = new Date();
  const last = toDate_(cfg.lastSent);
  if (!force && last && (now - last) < cfg.digestDays * DAY - 2 * 3600 * 1000) return;

  const queue = readQueue_();
  const rows = collectRows_().filter(function (r) { return cfg.done.indexOf(r.status) < 0; });
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const horizon = new Date(today.getTime() + cfg.windowDays * DAY);
  const recent = new Date(today.getTime() - cfg.digestDays * DAY);

  const deadlines = rows.filter(function (r) { return r.deadline && r.deadline >= today && r.deadline <= horizon; })
    .sort(function (a, b) { return a.deadline - b.deadline; });
  const opening = rows.filter(function (r) { return r.opens && r.opens >= recent && r.opens <= horizon; })
    .sort(function (a, b) { return a.opens - b.opens; });

  const byType = function (type) {
    // de-duplicate identical findings
    const seen = {};
    return queue.filter(function (q) {
      const k = q[1] + q[3] + q[4] + q[6];
      if (q[1] !== type || seen[k]) return false;
      seen[k] = true; return true;
    });
  };
  const opened = byType('opened'), postings = byType('posting'), changed = byType('changed'), unreadable = byType('unreadable');

  const total = opened.length + postings.length + changed.length + unreadable.length + deadlines.length + opening.length;
  if (!force && total === 0) return;

  const tz = Session.getScriptTimeZone();
  const fmt = function (d) { return Utilities.formatDate(d, tz, 'EEE d MMM'); };
  const daysLeft = function (d) { return Math.round((d - today) / DAY); };
  const esc = function (s) { return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); };
  const link = function (url, text) { return url ? '<a href="' + esc(url) + '">' + esc(text) + '</a>' : esc(text); };
  const name = function (title, org) { return org ? title + ' — ' + org : title; };

  let html = '<div style="font-family:Arial,sans-serif;font-size:14px;color:#222;max-width:680px">';
  const section = function (heading, items) {
    if (!items.length) return;
    html += '<h3 style="color:#1F3864;margin:22px 0 6px">' + heading + '</h3><ul style="padding-left:18px;margin:0">' +
      items.map(function (i) { return '<li style="margin-bottom:8px">' + i + '</li>'; }).join('') + '</ul>';
  };

  section('Now open', opened.map(function (q) {
    return '<b>' + link(q[5], name(q[3], q[4])) + '</b><br><span style="color:#555">' + esc(q[6]) + '</span>';
  }));
  section('Deadlines in the next ' + cfg.windowDays + ' days', deadlines.map(function (r) {
    const n = daysLeft(r.deadline);
    return '<b>' + link(r.link, name(r.title, r.org)) + '</b> — ' + fmt(r.deadline) +
      ' (' + (n === 0 ? 'today' : n === 1 ? 'tomorrow' : n + ' days') + ')' +
      (r.status && r.status !== 'not started' ? ' · status: ' + esc(r.status) : '');
  }));
  section('New listings', postings.map(function (q) {
    return link(q[5], q[6]) + ' <span style="color:#555">(' + esc(q[4] || q[3]) + ')</span>';
  }));
  section('Expected to open around now', opening.map(function (r) {
    return link(r.link, name(r.title, r.org)) + ' — expected ' + fmt(r.opens) + '. Worth a check.';
  }));
  section('Application wording changed', changed.map(function (q) {
    return link(q[5], name(q[3], q[4])) + '<br><span style="color:#555">' + esc(q[6]).slice(0, 400) + '</span>';
  }));
  section('Could not read', unreadable.map(function (q) {
    return link(q[5], name(q[3], q[4])) + '<br><span style="color:#555">' + esc(q[6]) + '</span>';
  }));
  if (total === 0) html += '<p>Nothing new since the last digest. The system is running.</p>';
  html += '<p style="color:#888;font-size:12px;margin-top:26px">From your tracker: <a href="' + ss_().getUrl() +
    '">open the spreadsheet</a>. Set a row\'s Status to Applied or Not applying to stop alerts for it.</p></div>';

  const bits = [];
  if (opened.length) bits.push(opened.length + ' now open');
  if (deadlines.length) bits.push(deadlines.length + ' deadline' + (deadlines.length > 1 ? 's' : ''));
  if (postings.length) bits.push(postings.length + ' new listing' + (postings.length > 1 ? 's' : ''));
  if (opening.length) bits.push(opening.length + ' opening soon');
  const subject = 'Job alerts: ' + (bits.length ? bits.join(', ') : 'nothing new');

  MailApp.sendEmail({ to: cfg.email, subject: subject, htmlBody: html, name: 'Job alerts' });
  clearQueue_();
  setSetting_('Last digest sent', now);
}
